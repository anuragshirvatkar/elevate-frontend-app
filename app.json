{
  "expo": {
    "name": "Elevate",
    "slug": "elevate-frontend",
    "version": "1.0.4",
    "orientation": "portrait",
    "icon": "./assets/elevate-logo.png",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.nexgen.elevate"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/elevate-logo.png",
        "backgroundColor": "#000000"
      },
      "package": "com.nexgen.elevate",
      "targetSdkVersion": 35,
      "permissions": [],
      "googleServicesFile": "./google-services.json"
    },
    "web": {
      "favicon": "./assets/elevate-logo.png"
    },
    "scheme": "com.nexgen.elevate",
    "plugins": [
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Elevate to access your photos.",
          "cameraPermission": "Allow Elevate to use your camera."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/elevate-logo.png",
          "color": "#ffffff",
          "sounds": ["./assets/notification-bell.wav"]
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "targetSdkVersion": 35,
            "compileSdkVersion": 35,
            "enableCoreLibraryDesugaring": true
          }
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "bb1958d6-83d6-427d-9313-243fc78d9b1d"
      }
    },
    "owner": "nexgensoftwares"
  }
}
